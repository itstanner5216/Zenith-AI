{
  "name": "@zenith-ai/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORT=3010 pnpm next dev",
    "build:self-host": "pnpm next build",
    "build:ci": "pnpm next build",
    "build": "pnpm run db:migrate  && pnpm next build",
    "start": "PORT=${PORT:-3000} pnpm next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "ts:check": "pnpm tsc --noEmit",
    "db:generate": "pnpm drizzle-kit generate",
    "db:migrate": "pnpm dotenv -c -- drizzle-kit migrate",
    "db:studio": "pnpm dotenv -c -- drizzle-kit studio",
    "db:studio:prod": "pnpm dotenv -e .env.production.local -- drizzle-kit studio",
    "db:push": "pnpm dotenv -c -- drizzle-kit push"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "catalog:",
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/deepseek": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/groq": "catalog:",
    "@ai-sdk/mistral": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@hookform/resolvers": "^5.2.2",
    "@mistralai/mistralai": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "25.5.0",
    "ai": "catalog:",
    "autoprefixer": "10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "postcss": "8.5.8",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-hot-toast": "^2.6.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "wink-bm25-text-search": "^3.1.2",
    "wink-eng-lite-web-model": "^1.8.1",
