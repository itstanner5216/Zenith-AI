{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "strict": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "composite": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@zenith-ai/*": [
        "packages/*/src"
      ],
      "@/*": [
        "packages/web/*"
      ]
    }
  },
  "references": [
    {
      "path": "packages/plugin"
    },
    {
      "path": "packages/web"
    }
  ],
  "exclude": [
    "node_modules"
  ]
}
