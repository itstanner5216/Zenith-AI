# =============================================================================
# Vertex AI Search + Obsidian Gateway — Environment Configuration
# v3.1.0
# =============================================================================

# -----------------------------------------------------------------------------
# GOOGLE CLOUD (required for Vertex AI features; gateway starts degraded without)
# -----------------------------------------------------------------------------
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_PROJECT_NUMBER=123456789012
GOOGLE_LOCATION=global
GOOGLE_DATASTORE_ID=your-datastore-id
GOOGLE_ENGINE_ID=your-engine-id
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# -----------------------------------------------------------------------------
# VERTEX AI MODEL CONFIGURATION (centralized — all in one place)
#
# VERTEX_ANSWER_MODEL     — Discovery Engine :answer endpoint model version
#                           "stable" = let API pick its current GA best
# VERTEX_GROUNDING_MODEL  — :generateGroundedContent model
# VERTEX_MODEL_REASONING  — highest-quality Gemini role
# VERTEX_MODEL_BALANCED   — balanced cost/quality role
# VERTEX_MODEL_FAST       — cheapest/fastest role
# -----------------------------------------------------------------------------
VERTEX_ANSWER_MODEL=stable
VERTEX_GROUNDING_MODEL=gemini-2.5-flash
VERTEX_MODEL_REASONING=gemini-2.5-pro
VERTEX_MODEL_BALANCED=gemini-2.5-flash
VERTEX_MODEL_FAST=gemini-2.5-flash-lite
VERTEX_EMBEDDING_MODEL=text-embedding-004
VERTEX_EMBEDDING_LOCATION=us-central1
VERTEX_EMBEDDING_DIMENSIONS=768

# -----------------------------------------------------------------------------
# OBSIDIAN LOCAL REST API (optional — gateway auto-reconnects when available)
# -----------------------------------------------------------------------------
OBSIDIAN_API_URL=https://host.docker.internal:27124
OBSIDIAN_API_KEY=your-obsidian-api-key
OBSIDIAN_VERIFY_TLS=false
OBSIDIAN_HEALTH_CACHE_SECONDS=30
OBSIDIAN_RECONNECT_INTERVAL=10

# -----------------------------------------------------------------------------
# GATEWAY SERVICE
# -----------------------------------------------------------------------------
REQUEST_TIMEOUT=60
MAX_RETRIES=3
RETRY_DELAY=1.0
LOG_LEVEL=INFO
SERVICE_PORT=8085
GATEWAY_PORT=8085

# -----------------------------------------------------------------------------
# OPENWEBUI + LLM BACKEND
#
# Point to your existing external LiteLLM instance.
# If using the bundled optional LiteLLM (docker compose --profile litellm up),
# set: OPENAI_API_BASE_URL=http://litellm:4000/v1
# -----------------------------------------------------------------------------
OPENAI_API_BASE_URL=http://host.docker.internal:4000/v1
OPENAI_API_KEY=sk-any-string
WEBUI_SECRET_KEY=your-secret-key-change-this
OPENWEBUI_PORT=3001

# -----------------------------------------------------------------------------
# LITELLM (optional bundled — only used with --profile litellm)
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-litellm-master-key
LITELLM_PORT=4000
ANTHROPIC_API_KEY=sk-your-anthropic-key
GEMINI_API_KEY=your-gemini-key

# -----------------------------------------------------------------------------
# TOOL CONFIGURATION (OpenWebUI Filter — no longer a Tool)
# Install vertex_gateway_filter.py via OpenWebUI UI:
#   Workspace > Functions > Add Filter > paste file contents
# -----------------------------------------------------------------------------
GATEWAY_URL=http://gateway:8085
TOOL_TIMEOUT=60
SESSION_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# REDIS (isolated from LiteLLM's Redis — separate session storage)
# Default port 6381 to avoid conflict with litellm-redis on 6379
# and memory-redis on 6380.
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=vertex_session:
SESSION_TTL_SECONDS=1800
REDIS_EXTERNAL_PORT=6381

# -----------------------------------------------------------------------------
# PGVECTOR (required for vault embeddings and vector search features)
# Format: postgresql://user:password@host:port/database
# PG_DSN takes precedence when set; individual vars used as fallback by infra.
# -----------------------------------------------------------------------------
PG_DSN=postgresql://zenith:your-password@localhost:5432/zenith_vectors
PGVECTOR_HOST=pgvector
PGVECTOR_PORT_INTERNAL=5432
PGVECTOR_DB=vault_embeddings
PGVECTOR_USER=vault
PGVECTOR_PASSWORD=vault-secure-pass

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
